{
  "name": "corazon-the-haunted-house",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.ts",
    "build": "npm run typecheck && vite build",
    "build:validation": "npm run typecheck && vite build --mode validation",
    "preview:validation": "vite preview --mode validation --host 127.0.0.1 --port 4174",
    "preview": "vite preview --host 127.0.0.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "babylonjs": "9.28.0",
    "typescript": "7.0.2",
    "vite": "8.3.2"
  }
}
